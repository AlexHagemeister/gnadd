#!/usr/bin/env bash
# Fake `gh` for the gnadd test suite. Behavior is driven by GH_STUB_* env
# vars; every invocation is appended to $GH_STUB_LOG so tests can assert
# which gh operations ran (and which did not).
#
#   GH_STUB_PR_STATE      e.g. OPEN / MERGED / CLOSED   (unset = "no PR")
#   GH_STUB_PR_NUMBER     e.g. 7
#   GH_STUB_PR_URL        e.g. https://github.com/o/r/pull/7
#   GH_STUB_MERGEABLE     e.g. MERGEABLE / CONFLICTING / UNKNOWN
#   GH_STUB_MERGED_AT     e.g. 2026-07-17T00:00:00Z     (unset = null)
#   GH_STUB_MERGE_COMMIT  e.g. abc123
#   GH_STUB_PR_HEAD       the PR's head branch name (headRefName)
#   GH_STUB_PR_HEAD_OID   the PR's head commit sha (headRefOid; unset = unknown)
#   GH_STUB_CHECKS        tab-separated check rows, e.g. 'test\tpass\t1s\turl'
#                         (\n for multiple rows; unset = "no checks reported")
#   GH_STUB_FAIL          set = every command fails
#   GH_STUB_ROUND_COUNT   existing round comments on an issue (unset = 0)
#   GH_STUB_ROUND_BODIES  bodies for `round list` (\n-separated, printf %b)
#   GH_STUB_ROUND_LAST    kind of the latest marked comment: round / feedback (unset = round)
#   GH_STUB_COMMENT_FILE  where `issue comment --body-file` copies its body
#   GH_STUB_PHASES        open milestones as tab rows 'num\ttitle\topen\tclosed\tdesc'
#                         (\n for multiple rows; unset = none open)
#   GH_STUB_PHASE_DESC    raw description returned for a single milestone GET
#   GH_STUB_API_INPUT     where `api --input -` writes the request body it read
#   GH_STUB_RULESETS      existing ruleset names, one per line (unset = none)
#   GH_STUB_RULESET_FAIL  set = creating a ruleset fails with this text on stderr
#   GH_STUB_QROWS / _<N>  question rows for item N's comments, as gnadd's qrow jq
#                         emits them ('comment\tq\t1\tlogin\ttext', \n-separated)
#   GH_STUB_QBODY / _<N>  the same row for item N's body (unset = 'body\treply')
#   GH_STUB_OPEN_ITEMS    open assigned items as 'num\tissue|pr\ttitle' rows
#   GH_STUB_ASSIGN_IGNORED set = adding an assignee returns without them
#   GH_STUB_OTHER_ASSIGNEES n other assignees listed after the added one (unset = 0)
#   GH_STUB_ITEM_META     an item's state and assignees, 'open\tlogin login' (unset = open, none)
#   GH_STUB_UNASSIGN_FAIL set = removing an assignee fails
#   GH_STUB_ISSUE_NUMBER  number `issue create` reports (unset = 99)
#   GH_STUB_ITEM_READ_FAIL set = reading an item's state and assignees fails (404)
#   GH_STUB_QREAD_FAIL    set = reading an item's question rows fails (404)
#   GH_STUB_ISSUE_CLOSE_FAIL set = `issue close` fails

set -u

[ -n "${GH_STUB_LOG:-}" ] && printf 'gh %s\n' "$*" >> "$GH_STUB_LOG"

[ -n "${GH_STUB_FAIL:-}" ] && exit 1

# Extract the --jq expression if present.
jq_expr=""
prev=""
for a in "$@"; do
  [ "$prev" = "--jq" ] && jq_expr="$a"
  prev="$a"
done

not_found() { # what real `gh api` does on a 404: the error body on stdout, one line on stderr, exit 1
  printf '%s\n' '{"message":"Not Found","documentation_url":"https://docs.github.com/rest","status":"404"}'
  printf 'gh: Not Found (HTTP 404)\n' >&2
  exit 1
}

emit_or_missing() { # emit_or_missing <value>
  if [ -n "$1" ]; then
    printf '%s\n' "$1"
    exit 0
  fi
  exit 1
}

case "$1" in
  auth)
    exit 0
    ;;
  pr)
    case "$2" in
      view)
        # "No PR for this branch" is modeled as unset GH_STUB_PR_STATE.
        [ -z "${GH_STUB_PR_STATE:-}" ] && exit 1
        case "$jq_expr" in
          .state)            emit_or_missing "${GH_STUB_PR_STATE:-}" ;;
          .number)           emit_or_missing "${GH_STUB_PR_NUMBER:-}" ;;
          .url)              emit_or_missing "${GH_STUB_PR_URL:-}" ;;
          .mergeable)        emit_or_missing "${GH_STUB_MERGEABLE:-}" ;;
          .mergedAt)         printf '%s\n' "${GH_STUB_MERGED_AT:-null}"; exit 0 ;;
          .mergeCommit.oid)  emit_or_missing "${GH_STUB_MERGE_COMMIT:-}" ;;
          .headRefName)      emit_or_missing "${GH_STUB_PR_HEAD:-}" ;;
          .headRefOid)       emit_or_missing "${GH_STUB_PR_HEAD_OID:-}" ;;
          *)                 exit 0 ;;
        esac
        ;;
      checks)
        if [ -n "${GH_STUB_CHECKS:-}" ]; then
          printf '%b\n' "$GH_STUB_CHECKS"
        else
          echo "no checks reported"
        fi
        exit 0
        ;;
      merge)
        exit 0
        ;;
      create)
        printf 'https://github.com/stub-owner/stub-repo/pull/%s\n' "${GH_STUB_PR_NUMBER:-1}"
        exit 0
        ;;
      *) exit 0 ;;
    esac
    ;;
  repo)
    case "$2" in
      view) emit_or_missing "stub-owner/stub-repo" ;;
      edit) exit 0 ;;
      *) exit 0 ;;
    esac
    ;;
  api)
    # Any api call with --input - records its request body for assertions.
    has_input=0
    for a in "$@"; do [ "$a" = "--input" ] && has_input=1; done
    if [ "$has_input" = 1 ]; then
      if [ -n "${GH_STUB_API_INPUT:-}" ]; then cat > "$GH_STUB_API_INPUT"; else cat >/dev/null; fi
    fi
    # Questions: comment posts copy their body; assignee adds echo the login
    # back; reads that use gnadd's qrow jq return the fixture rows.
    for a in "$@"; do
      case "$a" in body=@*) [ -n "${GH_STUB_COMMENT_FILE:-}" ] && cp "${a#body=@}" "$GH_STUB_COMMENT_FILE" ;; esac
    done
    case "$*" in
      *"-X POST"*/assignees*)
        [ -n "${GH_STUB_ASSIGN_IGNORED:-}" ] && exit 0
        for a in "$@"; do case "$a" in "assignees[]="*) printf '%s\n' "${a#assignees[]=}" ;; esac; done
        i=0; while [ "$i" -lt "${GH_STUB_OTHER_ASSIGNEES:-0}" ]; do printf 'other-assignee-%s\n' "$i"; i=$((i+1)); done
        exit 0 ;;
      *"-X DELETE"*/assignees*) [ -n "${GH_STUB_UNASSIGN_FAIL:-}" ] && exit 1; exit 0 ;;
    esac
    case "$jq_expr" in
      *'(.state)'*)
        [ -n "${GH_STUB_ITEM_READ_FAIL:-}" ] && not_found
        printf '%b\n' "${GH_STUB_ITEM_META:-open\t}"; exit 0 ;;
      *qrow*)
        [ -n "${GH_STUB_QREAD_FAIL:-}" ] && not_found
        qn="${2#repos/\{owner\}/\{repo\}/issues/}"; qn="${qn%%/*}"
        case "$2" in
          */comments) v="GH_STUB_QROWS_$qn"; rows="${!v:-${GH_STUB_QROWS:-}}"; [ -n "$rows" ] && printf '%b\n' "$rows" ;;
          *)          v="GH_STUB_QBODY_$qn"; printf '%b\n' "${!v:-${GH_STUB_QBODY:-body\treply}}" ;;
        esac
        exit 0 ;;
    esac
    case "$2" in
      */issues\?*) [ -n "${GH_STUB_OPEN_ITEMS:-}" ] && printf '%b\n' "$GH_STUB_OPEN_ITEMS"; exit 0 ;;
    esac
    # Milestones: list (count or rows), single GET (description), create (number + url).
    method=GET
    prev=""
    for a in "$@"; do [ "$prev" = "-X" ] && method="$a"; prev="$a"; done
    path=""
    for a in "$@"; do case "$a" in repos/*) path="$a" ;; esac; done
    case "$path" in
      */milestones\?*)
        case "$jq_expr" in
          length) n=0; [ -n "${GH_STUB_PHASES:-}" ] && n=$(printf '%b\n' "$GH_STUB_PHASES" | grep -c .); printf '%s\n' "$n" ;;
          *)      [ -n "${GH_STUB_PHASES:-}" ] && printf '%b\n' "$GH_STUB_PHASES" ;;
        esac
        exit 0 ;;
      */milestones)
        [ "$method" = POST ] && printf '42\thttps://github.com/stub-owner/stub-repo/milestone/42\n'
        exit 0 ;;
      */milestones/*)
        [ "$method" = GET ] && printf '%b\n' "${GH_STUB_PHASE_DESC:-}"
        exit 0 ;;
    esac
    # Issue comments: a count when the jq asks for length, bodies otherwise.
    case "$2" in
      */issues/*/comments)
        case "$jq_expr" in
          *length*)     printf '%s\n' "${GH_STUB_ROUND_COUNT:-0}" ;;
          *if\ contains*) [ "${GH_STUB_ROUND_COUNT:-0}" -gt 0 ] && printf '%s\n' "${GH_STUB_ROUND_LAST:-round}" ;;
          *)            [ -n "${GH_STUB_ROUND_BODIES:-}" ] && printf '%b\n' "$GH_STUB_ROUND_BODIES" ;;
        esac
        exit 0 ;;
    esac
    # Rulesets: list returns GH_STUB_RULESETS names; create succeeds.
    case "$path" in
      */rulesets)
        if [ "$method" = POST ] && [ -n "${GH_STUB_RULESET_FAIL:-}" ]; then
          printf '%s\n' "$GH_STUB_RULESET_FAIL" >&2; exit 1
        fi
        [ "$method" = GET ] && [ -n "${GH_STUB_RULESETS:-}" ] && printf '%b\n' "$GH_STUB_RULESETS"; exit 0 ;;
    esac
    exit 0
    ;;
  issue)
    case "$2" in
      comment)
        prev=""
        for a in "$@"; do
          [ "$prev" = "--body-file" ] && [ -n "${GH_STUB_COMMENT_FILE:-}" ] && cp "$a" "$GH_STUB_COMMENT_FILE"
          prev="$a"
        done
        exit 0 ;;
      create)
        prev=""
        for a in "$@"; do
          [ "$prev" = "--body-file" ] && [ -n "${GH_STUB_COMMENT_FILE:-}" ] && cp "$a" "$GH_STUB_COMMENT_FILE"
          prev="$a"
        done
        printf 'https://github.com/stub-owner/stub-repo/issues/%s\n' "${GH_STUB_ISSUE_NUMBER:-99}"
        exit 0 ;;
      close)
        if [ -n "${GH_STUB_ISSUE_CLOSE_FAIL:-}" ]; then
          printf 'failed to close issue: HTTP 502: Bad Gateway\n' >&2; exit 1
        fi
        exit 0 ;;
      *) exit 0 ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
